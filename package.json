{
  "name": "classroom-template",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "imports": {
    "#kernel/*": "./kernel/*",
    "#components/*": "./components/*",
    "#primitives/*": "./primitives/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && node kernel/server/index.js",
    "server": "node kernel/server/index.js",
    "manage": "node scripts/manage/index.js",
    "test": "npm run test:server && npm run test:client && npm run check:ui",
    "test:server": "node --test \"kernel/server/__tests__/**/*.test.js\" \"kernel/test-utils/__tests__/**/*.test.js\" \"kernel/build/__tests__/*.test.js\" \"examples/minimal/stages/*/__tests__/*.test.js\" \"examples/python-intro/stages/*/__tests__/*.test.js\" \"examples/anti-fraud/stages/*/__tests__/*.test.js\" \"components/*/__tests__/*.test.js\" \"examples/*/components/*/__tests__/*.test.js\" \"lessons/*/components/*/__tests__/*.test.js\" \"primitives/*/__tests__/*.test.js\" \"primitives/_shared/__tests__/*.test.js\" \"scripts/__tests__/components.test.js\" \"scripts/__tests__/check-requires.test.js\" \"scripts/__tests__/check-ui.test.js\" \"scripts/__tests__/lesson-primitives.test.js\" \"scripts/__tests__/strip-stage-options-build.test.js\" \"scripts/__tests__/pyodide-fetch.test.js\" \"scripts/__tests__/pack-runtime.test.js\" \"scripts/__tests__/runtime-zip.test.js\" \"scripts/__tests__/update-platform.test.js\" \"scripts/__tests__/check-lesson.test.js\" \"scripts/__tests__/pyrun-node.test.js\" \"scripts/__tests__/hidden-tests.test.js\" \"scripts/__tests__/prep-tests.test.js\" \"scripts/__tests__/new-lesson.test.js\" \"scripts/__tests__/new-stage.test.js\" \"scripts/__tests__/new-component.test.js\" \"scripts/__tests__/build-lesson.test.js\" \"scripts/__tests__/style-doc.test.js\" \"scripts/__tests__/ai-entry.test.js\" \"scripts/__tests__/lib.test.js\" \"scripts/__tests__/simulate.test.js\" \"scripts/__tests__/load.test.js\" \"scripts/__tests__/rename-banji.test.js\" \"scripts/__tests__/readme.test.js\" \"scripts/__tests__/skill-docs.test.js\" \"scripts/manage/__tests__/*.test.js\"",
    "test:client": "vitest run",
    "check:ui": "node scripts/check-ui.mjs",
    "check:lesson": "node scripts/check-lesson.mjs",
    "prep:tests": "node scripts/prep-tests.mjs",
    "build:lesson": "node scripts/build-lesson.mjs",
    "new:lesson": "node scripts/new-lesson.mjs",
    "new:stage": "node scripts/new-stage.mjs",
    "new:component": "node scripts/new-component.mjs",
    "gen:ai-entry": "node scripts/gen-ai-entry.mjs",
    "simulate": "node scripts/simulate.js",
    "e2e:restart": "node scripts/e2e-restart.js",
    "load": "node scripts/load.js",
    "test:pyodide": "node --test \"components/*/__tests__/pyodide/*.test.js\" \"scripts/__tests__/pyodide/*.test.js\"",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@lezer/python": "^1.1.19",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^18.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "mammoth": "^1.12.3",
    "qrcode.react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.0",
    "subset-font": "^2.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
