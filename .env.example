# 平台配置。日常请用管理台（双击 管理台.command / 管理台.bat）修改，它会自动生成并维护 .env。
# .env 含密码，不会进入版本库。

# 服务端口。80 让学生直接输入 http://<ip>/ 访问（Mac、Windows 默认）；Linux 上 80 需要管理员权限，建议 3001 或 8080。
# 开发模式（npm run dev）的 Vite 代理指向 3001，单独跑服务端调试时请用 PORT=3001。
PORT=80

# SQLite 数据库路径（相对项目目录）
DB_PATH=data/classroom.sqlite

# 教师登录密码（必填）。留空则无法启动平台。
TEACHER_PASSWORD=

# 教师登录状态保存文件（重启后教师无需重新登录）
AUTH_TOKEN_FILE=data/teacher_tokens.json

# 课程配置文件（相对项目目录）
LESSON_CONFIG=./lesson.config.js

# AI 参数（预留给 coach 组件；可留空）：接口地址须以 http:// 或 https:// 开头
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
